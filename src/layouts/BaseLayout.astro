---
/**
 * BaseLayout: every SEO, social, AI and local-search signal lives here.
 * Pages pass their own title/description/schema; nothing is hard-coded per page.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_URL, SITE_NAME, person, social, hospitals } from '../data/site';
import { breadcrumbNode, type Crumb } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile' | 'video.other';
  schema?: Record<string, any>;
  crumbs?: Crumb[];
  showBreadcrumbs?: boolean;
  noindex?: boolean;
  lang?: 'en' | 'ms';
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  video?: { id: string; seconds: number; uploadDate: string };
  preconnectYouTube?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/og/default.jpg',
  ogImageAlt = `${person.name}, ${person.jobTitle} in Shah Alam, Malaysia`,
  ogType = 'website',
  schema,
  crumbs = [],
  showBreadcrumbs = true,
  noindex = false,
  lang = 'en',
  article,
  video,
  preconnectYouTube = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).href;
const htmlLang = lang === 'ms' ? 'ms-MY' : 'en-MY';
const ogLocale = lang === 'ms' ? 'ms_MY' : 'en_MY';
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Merge breadcrumb node into the page graph so there is exactly one JSON-LD block.
let jsonLd = schema;
if (schema && crumbs.length > 1) {
  jsonLd = { ...schema, '@graph': [...(schema['@graph'] ?? []), breadcrumbNode(canonical, crumbs)] };
}

const gscToken = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingToken = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const ash = hospitals[0];
---
<!doctype html>
<html lang={htmlLang} dir="ltr" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="author" content={person.name} />
    <meta name="publisher" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <!-- Language targeting -->
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Local / geographic signals -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Shah Alam, Selangor, Malaysia" />
    {ash.geo && <meta name="geo.position" content={`${ash.geo.latitude};${ash.geo.longitude}`} />}
    {ash.geo && <meta name="ICBM" content={`${ash.geo.latitude}, ${ash.geo.longitude}`} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article && <meta property="article:author" content={`${SITE_URL}/about-dr-kartini/`} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    {ogType === 'profile' && <meta property="profile:first_name" content={person.givenName} />}
    {ogType === 'profile' && <meta property="profile:last_name" content={person.familyName} />}
    {ogType === 'profile' && <meta property="profile:gender" content="female" />}
    {video && <meta property="og:video" content={`https://www.youtube.com/embed/${video.id}`} />}
    {video && <meta property="og:video:type" content="text/html" />}
    {video && <meta property="video:duration" content={String(video.seconds)} />}
    {video && <meta property="video:release_date" content={video.uploadDate} />}

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons & app -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Feeds, sitemap & AI-readable summaries -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: Articles`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" title="LLM-readable site summary" href="/llms.txt" />

    <!-- Identity verification (rel=me) -->
    <link rel="me" href={social.linkedin} />
    <link rel="me" href={social.facebook} />
    <link rel="me" href={social.youtube} />

    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    {bingToken && <meta name="msvalidate.01" content={bingToken} />}

    {preconnectYouTube && <link rel="preconnect" href="https://i.ytimg.com" />}

    <Font cssVariable="--font-sans" preload={[{ weight: '400 700', style: 'normal' }]} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4, { anonymize_ip: true });
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {showBreadcrumbs && crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Conversion tracking for the KPI plan: WhatsApp, phone, appointment and email clicks.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var type = a.dataset.track ||
          (href.indexOf('wa.me') > -1 ? 'whatsapp_click' :
          href.indexOf('tel:') === 0 ? 'phone_click' :
          href.indexOf('mailto:') === 0 ? 'email_click' : null);
        if (!type) return;
        var detail = { event: type, link_url: href, link_text: (a.textContent || '').trim().slice(0, 80), page_path: location.pathname };
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(detail);
        if (typeof window.gtag === 'function') window.gtag('event', type, detail);
      });
    </script>
  </body>
</html>

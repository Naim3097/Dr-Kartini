---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Dr Kartini Farah Rahim" description="Sorry, this page could not be found. Explore dermatology guides, appointments and Dr Kartini’s work in animal welfare and the environment." path="/404/" noindex>
  <section class="section">
    <div class="container--narrow center">
      <p class="muted">Error 404</p>
      <h1>Page not found</h1>
      <p class="lead">This page may have moved when the website was rebuilt. Try one of these instead.</p>
      <div class="btn-row" style="justify-content:center;margin-top:1.5rem">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--secondary" href="/dermatology/">Skin conditions</a>
        <a class="btn btn--secondary" href="/appointments/">Appointments</a>
        <a class="btn btn--secondary" href="/articles/">Articles</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/pages';
import { contact, hospitals, social } from '../data/site';
import { graph, webPageNode, abs, ids } from '../lib/schema';
import { whatsappHref } from '../lib/whatsapp';

const meta = pages.contact;
const url = abs(meta.path);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;

const sources = [
  'Google search',
  'AI assistant (ChatGPT, Gemini, Perplexity, etc.)',
  'News article or newspaper',
  'Television',
  'Facebook',
  'Instagram',
  'TikTok',
  'YouTube',
  'LinkedIn',
  'Avisena Hospital website or staff',
  'Referred by another doctor',
  'Friend or family',
  'Animal welfare or community work',
  'Other',
];

const schema = graph([
  webPageNode({ url, type: 'ContactPage', name: meta.title, description: meta.description, imageUrl: abs('/og/page/contact.jpg'), about: { '@id': ids.person }, mainEntity: { '@id': ids.physician } }),
]);
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} ogImage="/og/page/contact.jpg" schema={schema} crumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: meta.path }]}>
  <header class="page-hero">
    <div class="container">
      <h1>Contact</h1>
      <p class="lead">For appointments, media requests, speaking invitations and collaborations.</p>
    </div>
  </header>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <table class="facts-table">
          <tbody>
            <tr>
              <th scope="row">WhatsApp</th>
              <td>
                <a href={whatsappHref(meta.path)} target="_blank" rel="noopener" data-track="whatsapp_click">{contact.whatsappDisplay}</a>
                <br /><span class="muted small">{contact.whatsappNote}</span>
              </td>
            </tr>
            <tr>
              <th scope="row">Appointments</th>
              <td>
                <a href={`tel:${contact.appointmentsE164}`} data-track="phone_click">{contact.appointmentsDisplay}</a> (Avisena appointments)
                <br /><a href={`tel:${contact.hospitalGeneralE164}`}>{contact.hospitalGeneralDisplay}</a> (Avisena general line)
              </td>
            </tr>
            <tr>
              <th scope="row">Email</th>
              <td>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
                <br /><span class="muted small">Best for media, speaking and collaboration requests.</span>
              </td>
            </tr>
            {
              hospitals.map((h) => (
                <tr>
                  <th scope="row">{h.name}</th>
                  <td>
                    {h.streetAddress}, {h.postalCode} {h.locality}, {h.region}
                    <br />
                    <a href={h.mapUrl} target="_blank" rel="noopener">Directions</a>
                  </td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">Social media</th>
              <td>
                <a href={social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>,{' '}
                <a href={social.facebook} rel="me noopener" target="_blank">Facebook</a>,{' '}
                <a href={social.youtube} rel="me noopener" target="_blank">YouTube</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="form-panel">
        <h2>Send an enquiry</h2>
        <p class="small muted">Please do not include detailed medical information. For emergencies, go to the nearest emergency department or call 999.</p>
        <form class="form" id="enquiry" method="post" action={endpoint || '#'} data-endpoint={endpoint || ''}>
          <div class="row">
            <div><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" required /></div>
            <div><label for="f-phone">Phone <span class="hint">(optional)</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
          </div>
          <div><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
          <div>
            <label for="f-type">Enquiry type</label>
            <select id="f-type" name="type" required>
              <option value="Appointment">Appointment</option>
              <option value="Media request">Media request</option>
              <option value="Speaking invitation">Speaking invitation</option>
              <option value="Animal adoption">Animal adoption</option>
              <option value="Collaboration">Collaboration</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="f-source">How did you hear about Dr Kartini?</label>
            <select id="f-source" name="source" required>
              <option value="" selected disabled>Please choose</option>
              {sources.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div><label for="f-msg">Message</label><textarea id="f-msg" name="message" required></textarea></div>
          <input type="hidden" name="page" value="/contact/" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
          <p class="small muted" style="margin:0">By sending this form you agree to the <a href="/privacy-policy/">privacy policy</a>.</p>
          <div><button class="btn" type="submit">Send enquiry</button></div>
          <p class="small" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({ event: 'enquiry_submit', enquiry_type: data.get('type'), lead_source: data.get('source') });
    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        form.reset();
        if (status) status.textContent = 'Thank you. Your enquiry has been sent.';
        return;
      } catch {
        if (status) status.textContent = 'Sorry, the form could not be sent. Opening WhatsApp instead.';
      }
    }
    // No form backend configured: hand the enquiry to WhatsApp with the attribution answer included.
    const text = `Hello Dr Kartini,\n\nName: ${data.get('name')}\nEnquiry: ${data.get('type')}\nHeard about Dr Kartini via: ${data.get('source')}\n\n${data.get('message')}\n\n(Sent from expertdermatologist.com/contact/)`;
    window.open(`https://wa.me/601126166480?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });
</script>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .form-panel {
    padding: 1.5rem;
    background: var(--bg-alt);
    border-radius: var(--radius);
  }
  .form-panel h2 {
    font-size: 1.375rem;
  }
</style>

---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/pages';
import { person, contact, commentTopics, postNominals, registrations } from '../data/site';
import { graph, webPageNode, abs, ids } from '../lib/schema';
import headshot from '../assets/images/portraits/dr-kartini-farah-rahim-consultant-dermatologist.jpg';
import blazer from '../assets/images/portraits/dr-kartini-farah-rahim-black-blazer.jpg';
import kurung from '../assets/images/portraits/dr-kartini-farah-rahim-baju-kurung-stethoscope.jpg';
import white from '../assets/images/portraits/dr-kartini-farah-rahim-white-blazer.jpg';

const meta = pages.press;
const url = abs(meta.path);
const nsr = registrations.find((r) => r.name.includes('Dermatology'))!;

const shortBio = `Dr Kartini Farah Rahim is a Consultant Dermatologist at Avisena Specialist Hospital and Avisena Women’s & Children’s Specialist Hospital in Shah Alam, Selangor. She is Vice-President of the environmental NGO PEKA Malaysia and a board member of Filbert’s Foundation for Furry Friends.`;
const longBio = `Dr Kartini Farah Rahim (${postNominals}) is a Consultant Dermatologist on Malaysia’s National Specialist Register (No. ${nsr.value}). She began her dermatology career as a research fellow in Dundee, Scotland in 2004, became a Member of the Royal Colleges of Physicians of the United Kingdom in 2007, and completed an Advanced Master of Dermatology at Universiti Kebangsaan Malaysia in 2011. She has worked at Hospital Kuala Lumpur and Hospital Serdang, and was a Senior Lecturer in Medicine and Dermatology at Universiti Putra Malaysia for more than ten years. She practises at Avisena Specialist Hospital and Avisena Women’s & Children’s Specialist Hospital in Shah Alam, with a clinical focus on eczema, psoriasis, acne, skin infections, allergic skin reactions and blistering disorders. Dr Kartini is also Vice-President of Pertubuhan Pelindung Khazanah Alam Malaysia (PEKA), a board member of Filbert’s Foundation for Furry Friends, and a medical advisor to patient support groups for eczema, hidradenitis suppurativa and ichthyosis.`;

const headshots = [
  { img: headshot, file: '/press/dr-kartini-farah-rahim-consultant-dermatologist.jpg', label: 'White coat, square' },
  { img: blazer, file: '/press/dr-kartini-farah-rahim-black-blazer.jpg', label: 'Black blazer, portrait' },
  { img: kurung, file: '/press/dr-kartini-farah-rahim-baju-kurung-stethoscope.jpg', label: 'Baju kurung with stethoscope' },
  { img: white, file: '/press/dr-kartini-farah-rahim-white-blazer.jpg', label: 'White blazer, portrait' },
];

const schema = graph([
  webPageNode({ url, type: ['WebPage', 'ContactPage'], name: meta.title, description: meta.description, imageUrl: abs('/og/page/press.jpg'), about: { '@id': ids.person }, speakable: ['#short-bio'] }),
]);
const mailSubject = encodeURIComponent('Media enquiry for Dr Kartini Farah Rahim');
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} ogImage="/og/page/press.jpg" schema={schema} crumbs={[{ name: 'Home', path: '/' }, { name: 'Media', path: '/media/' }, { name: 'For journalists', path: meta.path }]}>
  <header class="page-hero">
    <div class="container">
      <h1>Media enquiries</h1>
      <p class="lead">
        Dr Kartini Farah Rahim is available for comment in English and Bahasa Malaysia on dermatology, and on animal welfare, the environment and women’s and
        children’s health, where she has direct experience.
      </p>
      <div class="btn-row">
        <a class="btn" href={`mailto:${contact.email}?subject=${mailSubject}`} data-track="press_email">Email {contact.email}</a>
        <a class="btn btn--secondary" href={`${contact.whatsappLink}?text=${encodeURIComponent('Hello Dr Kartini, I am a journalist and would like to request a comment. (Sent from drkartini.net/press/)')}`} target="_blank" rel="noopener" data-track="press_whatsapp">WhatsApp for urgent requests</a>
      </div>
      <p class="small muted note">Please include your outlet, deadline and the question you would like answered.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="topics-title">
    <div class="container">
      <h2 id="topics-title">Topics</h2>
      <div class="grid grid--2 topics">
        {
          commentTopics.map((t) => (
            <div>
              <h3>{t.area}</h3>
              <ul>
                {t.topics.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="notice">
        Dr Kartini comments only where she has professional or first-hand experience. As a registered medical practitioner, she does not endorse products or
        discuss individual patients.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="bio-title">
    <div class="container--narrow">
      <h2 id="bio-title">Biographies</h2>
      <h3>Name and title</h3>
      <p><strong>{person.name}</strong>, {person.jobTitle}. Please use “Dr Kartini Farah Rahim” on first reference and “Dr Kartini” after that.</p>
      <h3>Short biography</h3>
      <p id="short-bio" class="bio">{shortBio}</p>
      <h3>Long biography</h3>
      <p class="bio">{longBio}</p>
      <h3>Suggested captions</h3>
      <ul>
        <li>Dr Kartini Farah Rahim, Consultant Dermatologist, Avisena Specialist Hospital, Shah Alam</li>
        <li>Dr Kartini Farah Rahim, Consultant Dermatologist and animal welfare advocate</li>
        <li>Dr Kartini Farah Rahim, Vice-President, PEKA Malaysia</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="photos-title">
    <div class="container">
      <div class="section-head">
        <h2 id="photos-title">Photos</h2>
        <p class="muted">For editorial use, credited to Dr Kartini Farah Rahim.</p>
      </div>
      <div class="grid grid--4">
        {
          headshots.map((h) => (
            <figure>
              <div class="photo photo--portrait">
                <Image src={h.img} alt={`Dr Kartini Farah Rahim, ${h.label.toLowerCase()}`} width={400} height={500} fit="cover" position="top" />
              </div>
              <figcaption>
                {h.label}
                <br />
                <a href={h.file} target="_blank" rel="noopener">Full size</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <h2>Quick facts</h2>
      <table class="facts-table">
        <tbody>
          <tr><th scope="row">Full name</th><td>Dr Kartini Farah Rahim (also published as Dr Kartini Farah Abdul Rahim)</td></tr>
          <tr><th scope="row">Role</th><td>Consultant Dermatologist</td></tr>
          <tr><th scope="row">Registration</th><td>MMC No. 43483; National Specialist Register No. {nsr.value}</td></tr>
          <tr><th scope="row">Hospitals</th><td>Avisena Specialist Hospital; Avisena Women’s &amp; Children’s Specialist Hospital, Shah Alam</td></tr>
          <tr><th scope="row">Other roles</th><td>Vice-President, PEKA Malaysia; Board Member, Filbert’s Foundation for Furry Friends</td></tr>
          <tr><th scope="row">Languages</th><td>English, Bahasa Malaysia</td></tr>
          <tr><th scope="row">Media contact</th><td><a href={`mailto:${contact.email}`}>{contact.email}</a>; WhatsApp {contact.whatsappDisplay}</td></tr>
        </tbody>
      </table>
      <p class="section-foot"><a class="text-link" href="/media/">Previous media coverage</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .note {
    margin: 0.75rem 0 0;
  }
  .topics {
    margin-bottom: 2rem;
  }
  .topics h3 {
    font-size: 1.125rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .topics ul {
    padding-left: 1.2rem;
    margin: 0;
    color: var(--text-2);
  }
  .topics li + li {
    margin-top: 0.25rem;
  }
  .bio {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }
</style>

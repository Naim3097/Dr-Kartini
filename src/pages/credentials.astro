---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { pages } from '../data/pages';
import { qualifications, registrations, career, affiliations } from '../data/site';
import { graph, webPageNode, faqNode, abs, ids } from '../lib/schema';
import portrait from '../assets/images/portraits/dr-kartini-farah-rahim-seated-portrait.jpg';

const meta = pages.credentials;
const url = abs(meta.path);

const faqs = [
  {
    q: 'How can I verify Dr Kartini’s specialist registration?',
    a: 'Search for her name or registration number on the Malaysian Medical Council’s public register and on the National Specialist Register. Dr Kartini’s MMC number is 43483 and her National Specialist Register number is 128619, covering dermatology and internal medicine.',
  },
  {
    q: 'What does MRCP (UK) mean?',
    a: 'MRCP (UK) is Membership of the Royal Colleges of Physicians of the United Kingdom, a postgraduate qualification in internal medicine awarded after written and clinical examinations. Dr Kartini became a member in 2007.',
  },
  {
    q: 'What is FAADV?',
    a: 'FAADV stands for Fellow of the Asian Academy of Dermatology and Venereology, a professional body for dermatologists across Asia.',
  },
  {
    q: 'Is Dr Kartini also registered in the United Kingdom?',
    a: 'Dr Kartini holds General Medical Council (UK) registration number 5204337, from her years of training and work in the United Kingdom.',
  },
];

const schema = graph([
  webPageNode({ url, type: 'WebPage', name: meta.title, description: meta.description, imageUrl: abs('/og/page/credentials.jpg'), about: { '@id': ids.person }, mainEntity: { '@id': ids.person } }),
  faqNode(url, faqs),
]);
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} ogImage="/og/page/credentials.jpg" schema={schema} crumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about-dr-kartini/' }, { name: 'Qualifications', path: meta.path }]}>
  <header class="page-hero">
    <div class="container split split--center">
      <div>
        <h1>Qualifications and specialist registration</h1>
        <p class="lead">
          Dr Kartini Farah Rahim is registered with the Malaysian Medical Council and on the National Specialist Register. She trained in Ireland, the United Kingdom
          and Malaysia.
        </p>
      </div>
      <div class="photo photo--portrait hero-photo">
        <Image src={portrait} alt="Dr Kartini Farah Rahim in a formal portrait" widths={[400, 700]} width={700} sizes="(min-width: 900px) 340px, 80vw" loading="eager" />
      </div>
    </div>
  </header>

  <section class="section" aria-labelledby="reg-title">
    <div class="container">
      <div class="section-head">
        <h2 id="reg-title">Registration</h2>
        <p class="muted">Registration numbers are listed so that patients, journalists and colleagues can check them.</p>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Register</th><th scope="col">Number</th><th scope="col">Authority</th></tr>
          </thead>
          <tbody>
            {
              registrations.map((r) => (
                <tr>
                  <td>{r.name}</td>
                  <td>{r.value}</td>
                  <td><a href={r.url} target="_blank" rel="noopener">{r.authority}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="qual-title">
    <div class="container">
      <h2 id="qual-title">Qualifications</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Qualification</th><th scope="col">Full title</th><th scope="col">Awarded by</th><th scope="col">Year</th></tr>
          </thead>
          <tbody>
            {
              qualifications.map((q) => (
                <tr>
                  <td>{q.abbr}</td>
                  <td>{q.name}</td>
                  <td>{q.awardedBy}</td>
                  <td>{q.year ?? ''}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="career-title">
    <div class="container split split--even">
      <div>
        <h2 id="career-title">Clinical and academic career</h2>
        <ol class="year-list">
          {
            career.map((c) => (
              <li>
                <span class="year">{c.year}</span>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.org}. {c.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h2>Advisory and leadership roles</h2>
        <ul class="list-plain roles">
          {affiliations.map((a) => <li><strong>{a.role}</strong>, {a.org}</li>)}
        </ul>
        <p class="notice">
          This information comes from Dr Kartini’s own records and her specialist profiles at Avisena Specialist Hospital and Avisena Women’s &amp; Children’s
          Specialist Hospital.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <Faq faqs={faqs} heading="Questions about Dr Kartini’s credentials" />
    </div>
  </section>
</BaseLayout>
<style>
  .hero-photo {
    max-width: 340px;
    width: 100%;
    justify-self: center;
  }
  .roles {
    margin-bottom: 2rem;
  }
  .roles li {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .roles li + li {
    margin-top: 0.6rem;
  }
</style>

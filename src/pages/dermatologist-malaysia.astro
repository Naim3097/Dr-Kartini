---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConditionCard from '../components/ConditionCard.astro';
import KeyFacts from '../components/KeyFacts.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import AuthorBox from '../components/AuthorBox.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { pages } from '../data/pages';
import { hospitals, contact, registrations } from '../data/site';
import { getConditions } from '../lib/content';
import { graph, webPageNode, faqNode, abs, ids } from '../lib/schema';
import { whatsappHref } from '../lib/whatsapp';
import consult from '../assets/images/clinical/dermatology-consultation-dr-kartini.jpg';
import blazer from '../assets/images/portraits/dr-kartini-farah-rahim-white-blazer.jpg';

const meta = pages.dermatologistMalaysia;
const url = abs(meta.path);
const conditions = await getConditions();
const nsr = registrations.find((r) => r.name.includes('Dermatology'))!;

const facts = [
  { label: 'Dermatologist', value: 'Dr Kartini Farah Rahim, Consultant Dermatologist' },
  { label: 'Specialist register', value: `National Specialist Register No. ${nsr.value}` },
  { label: 'Location', value: 'Seksyen 14, Shah Alam, Selangor' },
  { label: 'Hospitals', value: 'Avisena Specialist Hospital; Avisena Women’s & Children’s Specialist Hospital' },
  { label: 'Patients', value: 'Adults, teenagers, children and babies' },
  { label: 'Languages', value: 'English and Bahasa Malaysia' },
  { label: 'Appointments', value: `${contact.appointmentsDisplay}; WhatsApp ${contact.whatsappDisplay}` },
];

const faqs = [
  {
    q: 'What is a consultant dermatologist?',
    a: 'A consultant dermatologist is a medical doctor who has completed specialist training in diagnosing and treating diseases of the skin, hair and nails, and who practises at consultant level. In Malaysia, specialists can be verified on the National Specialist Register.',
  },
  {
    q: 'Do I need a referral to see a dermatologist in Shah Alam?',
    a: 'Private specialist hospitals such as Avisena generally accept direct appointments, although a referral letter from your GP can be helpful because it summarises your history and treatments. Some insurance and corporate panels require a referral, so check with your provider before your visit.',
  },
  {
    q: 'What is the difference between a dermatologist and an aesthetic doctor?',
    a: 'A dermatologist is a medically trained skin specialist who diagnoses and treats skin disease, such as eczema, psoriasis, acne, infections and skin cancer concerns. Aesthetic practice focuses mainly on cosmetic appearance. If you have a rash, a persistent or painful skin problem, or a condition affecting a child, see a dermatologist.',
  },
  {
    q: 'What should I bring to my first dermatology appointment?',
    a: 'Bring a list of the medicines, creams and skincare products you have used, photos of your skin during flares, any previous test results or referral letters, and your questions. Arrive without make-up or nail polish if the affected area is your face or nails.',
  },
  {
    q: 'Can Dr Kartini see my child?',
    a: 'Yes. Dr Kartini sees babies, children and teenagers, and holds sessions at Avisena Women’s & Children’s Specialist Hospital in Shah Alam as well as Avisena Specialist Hospital.',
  },
  {
    q: 'How much does a dermatologist consultation cost?',
    a: 'Consultation fees at private hospitals in Malaysia follow the fee schedule regulated under the Private Healthcare Facilities and Services Act, and total costs depend on any tests, procedures or medicines needed. Please contact Avisena directly for current charges.',
  },
];

const schema = graph([
  webPageNode({
    url,
    type: 'MedicalWebPage',
    name: meta.title,
    description: meta.description,
    imageUrl: abs('/og/page/dermatologistMalaysia.jpg'),
    about: [{ '@id': ids.physician }, { '@type': 'MedicalSpecialty', name: 'Dermatology', '@id': 'https://schema.org/Dermatology' }],
    mainEntity: { '@id': ids.physician },
    speakable: ['.pillar-summary'],
    medicalAudience: true,
    reviewed: true,
    lastReviewed: '2026-09-14',
  }),
  faqNode(url, faqs),
]);
---
<BaseLayout title={meta.title} description={meta.description} path={meta.path} ogImage="/og/page/dermatologistMalaysia.jpg" schema={schema} crumbs={[{ name: 'Home', path: '/' }, { name: 'Dermatologist in Malaysia', path: meta.path }]}>
  <header class="page-hero">
    <div class="container split split--center">
      <div>
        <h1>Consultant Dermatologist in Malaysia: Dr Kartini Farah Rahim, Shah Alam</h1>
        <p class="lead pillar-summary">
          Dr Kartini Farah Rahim is a consultant dermatologist (pakar kulit) in Shah Alam, Selangor, registered on Malaysia’s National Specialist Register. She
          diagnoses and treats skin, hair and nail conditions in adults and children, including eczema, psoriasis, acne, skin infections, allergic reactions and
          blistering disorders, at Avisena Specialist Hospital and Avisena Women’s &amp; Children’s Specialist Hospital.
        </p>
        <div class="btn-row">
          <a class="btn" href="/appointments/" data-track="appointment_cta">Make an appointment</a>
          <a class="btn btn--secondary" href={whatsappHref(meta.path)} target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp {contact.whatsappDisplay}</a>
        </div>
      </div>
      <div class="photo photo--portrait hero-photo">
        <Image src={blazer} alt="Dr Kartini Farah Rahim, consultant dermatologist in Malaysia" widths={[400, 744]} sizes="(min-width: 900px) 360px, 85vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container article-layout">
      <div>
        <KeyFacts facts={facts} heading="At a glance" />
        <div class="prose facts-gap">
        <h2>What does a dermatologist do?</h2>
        <p>
          A dermatologist is a doctor who specialises in the skin, the body’s largest organ, together with the hair, nails and the lining of the mouth and genitals.
          Dermatologists diagnose and manage thousands of different conditions, from common problems such as acne and eczema to complex autoimmune, genetic and
          infectious diseases.
        </p>
        <p>Seeing a dermatologist means you get:</p>
        <ul>
          <li><strong>An accurate diagnosis</strong>, because many rashes look alike but need very different treatment.</li>
          <li><strong>Prescription treatment</strong> when over-the-counter products are not enough, including topical, oral, light-based and biologic therapies where appropriate.</li>
          <li><strong>Investigations</strong> such as skin scrapings, swabs, blood tests or a skin biopsy.</li>
          <li><strong>Long-term care plans</strong> for chronic conditions, with follow-up that adjusts as your skin changes.</li>
        </ul>

        <h2>When should you see a dermatologist in Malaysia?</h2>
        <p>Consider booking a consultation if you have:</p>
        <ul>
          <li>A rash, itch or skin problem lasting more than a few weeks despite simple care</li>
          <li>Acne that is painful, leaves scars or dark marks, or affects your confidence</li>
          <li>Eczema or psoriasis that disturbs sleep, school or work</li>
          <li>Repeated skin infections, boils or fungal rashes</li>
          <li>A reaction to a cream, cosmetic, medicine or food affecting your skin</li>
          <li>Blisters, sores in the mouth, or skin that is peeling</li>
          <li>A mole or spot that is new, changing, bleeding or different from the rest</li>
          <li>Hair loss or nail changes without an obvious cause</li>
        </ul>
        <p>
          In Malaysia’s hot, humid climate, sweat, heat and haze can make many skin conditions flare, and unregulated creams sold online can cause harm. If you are
          unsure, read <a href="/articles/when-to-see-a-dermatologist-instead-of-skincare/">when to see a dermatologist instead of trying another skincare product</a>.
        </p>

        <h2>How do you choose a dermatologist in Malaysia?</h2>
        <p>
          Check that the doctor is registered with the Malaysian Medical Council and listed on the National Specialist Register for dermatology, ask about their
          experience with your condition, and choose someone who explains your diagnosis and options clearly. Our guide on
          <a href="/articles/how-to-choose-a-dermatologist-in-malaysia/">how to choose a dermatologist in Malaysia</a> explains what to look for.
        </p>
        <p>
          Dr Kartini’s registration details are published on her <a href="/credentials/">qualifications page</a> so that you can verify them.
        </p>

        <h2>What happens at a consultation with Dr Kartini?</h2>
        <ol>
          <li><strong>History.</strong> Dr Kartini asks about your symptoms, triggers, family history, and the treatments and products you have tried.</li>
          <li><strong>Examination.</strong> She examines the affected skin, and often the scalp, nails and other areas that give diagnostic clues.</li>
          <li><strong>Diagnosis and tests.</strong> Most conditions are diagnosed clinically; some need a swab, scraping, blood test or biopsy.</li>
          <li><strong>A plan you understand.</strong> You leave with a clear explanation, a treatment plan and advice on skin care at home.</li>
          <li><strong>Follow-up.</strong> Chronic conditions are reviewed over time so that treatment can be stepped up or down safely.</li>
        </ol>

        <h2>About Dr Kartini</h2>
        <p>
          Dr Kartini has worked in dermatology since 2004, trained in the United Kingdom and at Universiti Kebangsaan Malaysia, served at Hospital Kuala Lumpur and
          Hospital Serdang, and taught medicine and dermatology at Universiti Putra Malaysia for more than ten years. She is a medical advisor to Malaysian patient
          support groups for eczema, hidradenitis suppurativa and ichthyosis, and explains skin health regularly on television and in print. Consultations are
          available in English and Bahasa Malaysia.
        </p>
        </div>
      </div>
      <aside class="article-aside">
        <div class="photo photo--landscape"><Image src={consult} alt="Dr Kartini in a dermatology consultation with a patient" width={600} height={400} fit="cover" /></div>
        {
          hospitals.map((h) => (
            <div class="aside-block">
              <h2>{h.name}</h2>
              <p>{h.streetAddress}, {h.postalCode} {h.locality}</p>
              <p><a href="/appointments/">Clinic hours</a>, <a href={h.mapUrl} target="_blank" rel="noopener">directions</a></p>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cond-title">
    <div class="container">
      <div class="section-head">
        <h2 id="cond-title">Skin conditions Dr Kartini treats</h2>
        <p class="muted">Each guide covers causes, symptoms, treatment and when to seek care.</p>
      </div>
      <div class="grid grid--3">
        {conditions.map((c) => <ConditionCard condition={c} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow">
      <Faq faqs={faqs} heading="Frequently asked questions" />
      <AuthorBox />
      <MedicalDisclaimer />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .hero-photo {
    max-width: 360px;
    width: 100%;
    justify-self: center;
  }
  .page-hero h1 {
    max-width: 26ch;
  }
  .facts-gap {
    margin-top: 2.5rem;
  }
  .aside-block p {
    margin: 0 0 0.3rem;
  }
</style>

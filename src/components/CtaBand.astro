---
import { contact } from '../data/site';
import { whatsappHref } from '../lib/whatsapp';
interface Props {
  heading?: string;
  text?: string;
  topic?: string;
}
const {
  heading = 'Make an appointment',
  text = 'Dr Kartini sees adults and children at Avisena Specialist Hospital and Avisena Women’s & Children’s Specialist Hospital in Shah Alam. Please WhatsApp first to confirm her schedule.',
  topic,
} = Astro.props;
const path = Astro.url.pathname;
---
<section class="section cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div>
      <h2 id="cta-title">{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn" href={whatsappHref(path, topic)} target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp {contact.whatsappDisplay}</a>
      <a class="btn btn--secondary" href="/appointments/">Clinic hours</a>
    </div>
  </div>
</section>
<style>
  .cta {
    border-top: 1px solid var(--border);
  }
  .cta__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
  h2 {
    margin-bottom: 0.35rem;
  }
  p {
    margin: 0;
    max-width: 62ch;
    color: var(--text-2);
  }
</style>

---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  id?: string;
  headingLevel?: 'h2' | 'h3';
  openFirst?: boolean;
}
const { faqs, heading = 'Frequently asked questions', id = 'faq', headingLevel = 'h2', openFirst = false } = Astro.props;
const H = headingLevel;
---
{
  faqs.length > 0 && (
    <section class="faq-section" aria-labelledby={`${id}-title`}>
      <H id={`${id}-title`}>{heading}</H>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={openFirst && i === 0}>
            <summary>{f.q}</summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

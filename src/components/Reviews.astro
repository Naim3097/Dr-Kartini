---
import { reviewsFor } from '../lib/content';
interface Props {
  heading?: string;
  text?: string;
  topic?: string;
  more?: { href: string; text: string };
}
const {
  heading = 'Parents’ experiences',
  text = 'Parents have shared their children’s care with Dr Kartini on Threads. Every child is different, and results vary.',
  topic,
  more,
} = Astro.props;
const items = reviewsFor(topic);
const month = (iso: string) => new Date(iso).toLocaleDateString('en-MY', { month: 'long', year: 'numeric', timeZone: 'Asia/Kuala_Lumpur' });
---
{
  items.length > 0 && (
    <section class="section" aria-labelledby="reviews-title" data-threads>
      <div class="container">
        <div class="section-head">
          <h2 id="reviews-title">{heading}</h2>
          <p class="muted">{text}</p>
        </div>
        <div class="reviews__posts">
          {items.map((r) => (
            <div class="reviews__slot">
              <blockquote class="text-post-media" data-text-post-permalink={r.url} data-text-post-version="0" cite={r.url}>
                <div class="card review">
                  {r.quote ? (
                    <p class="review__text" lang={r.lang}>
                      “{r.quote}”
                    </p>
                  ) : (
                    <p class="review__text">{r.summary}</p>
                  )}
                  {r.quote && <p class="review__context">{r.summary}</p>}
                  <p class="card__meta">
                    <a class="review__who" href={r.url} target="_blank" rel="noopener">
                      {r.author} on Threads
                    </a>
                    {r.attribution}, {month(r.date)}
                  </p>
                </div>
              </blockquote>
            </div>
          ))}
        </div>
        {more && (
          <p class="section-foot">
            <a class="text-link" href={more.href}>
              {more.text}
            </a>
          </p>
        )}
      </div>
    </section>
  )
}
<script>
  // Threads' embed script swaps each card for the parent's post. It loads only when the
  // posts are about to scroll into view, so it never slows down the first paint.
  const section = document.querySelector('[data-threads]');
  if (section && 'IntersectionObserver' in window) {
    // Threads leaves the card in place, so hide it once the post has loaded and has a height.
    const ro = new ResizeObserver((entries) => {
      for (const e of entries) {
        if (e.contentRect.height > 0) e.target.closest('.reviews__slot')?.classList.add('is-embedded');
      }
    });
    new MutationObserver(() => section.querySelectorAll('iframe').forEach((f) => ro.observe(f))).observe(section, {
      childList: true,
      subtree: true,
    });
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://www.threads.com/embed.js';
        s.async = true;
        document.body.append(s);
      },
      { rootMargin: '800px 0px' },
    );
    io.observe(section);
  }
</script>
<style>
  /* Posts differ a lot in height, so they stack in two columns rather than sit in rows. */
  .reviews__posts {
    columns: 2 22rem;
    column-gap: 1.5rem;
  }
  .reviews__slot {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  .reviews__slot blockquote {
    margin: 0;
  }
  .reviews__slot.is-embedded blockquote {
    display: none;
  }
  /* The frame Threads puts in place of each card. */
  .reviews__slot :global(iframe) {
    display: block;
    width: 100%;
    max-width: 540px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .review__text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text);
  }
  .review__context {
    margin: 0.5rem 0 0;
    color: var(--text-2);
  }
  .review__who {
    display: block;
    font-weight: 600;
  }
</style>

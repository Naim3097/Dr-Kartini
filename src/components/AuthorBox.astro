---
import { Image } from 'astro:assets';
import headshot from '../assets/images/portraits/dr-kartini-farah-rahim-consultant-dermatologist.jpg';
import { person, postNominals, registrations } from '../data/site';
const nsr = registrations.find((r) => r.name.includes('Dermatology'))!;
---
<aside class="author-box" aria-labelledby="author-name">
  <Image src={headshot} alt="Dr Kartini Farah Rahim" width={160} height={160} />
  <div>
    <h2 class="author-name" id="author-name"><a href="/about-dr-kartini/" rel="author">{person.name}</a></h2>
    <p class="author-cred">{person.jobTitle}, {postNominals}</p>
    <p>
      Dr Kartini is on Malaysia’s National Specialist Register (No. {nsr.value}) and practises at Avisena Specialist Hospital and Avisena Women’s &amp; Children’s
      Specialist Hospital, Shah Alam. She taught medicine and dermatology at Universiti Putra Malaysia for more than ten years, and advises patient support
      groups for eczema, hidradenitis suppurativa and ichthyosis.
    </p>
    <p class="small"><a href="/credentials/">Qualifications</a><span class="sep">|</span><a href="/editorial-policy/">Editorial policy</a></p>
  </div>
</aside>
<style>
  .author-box {
    display: grid;
    gap: 1.25rem;
    margin-block: 2.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .author-box {
      grid-template-columns: 88px 1fr;
    }
  }
  .author-box img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }
  .author-name {
    font-size: 1.1875rem;
    margin: 0;
  }
  .author-name a {
    color: var(--text);
    text-decoration: none;
  }
  .author-name a:hover {
    text-decoration: underline;
  }
  .author-cred {
    margin: 0.1rem 0 0.6rem;
    color: var(--text-3);
    font-size: 0.9375rem;
  }
  .author-box p:last-child {
    margin: 0;
  }
  .sep {
    margin: 0 0.5rem;
    color: var(--border-strong);
  }
</style>

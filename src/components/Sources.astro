---
interface Props {
  sources: { title: string; publisher: string; url: string }[];
}
const { sources } = Astro.props;
---
{
  sources.length > 0 && (
    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources and further reading</h2>
      <ol>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener" target="_blank">{s.title}</a> <span class="muted">({s.publisher})</span>
          </li>
        ))}
      </ol>
    </section>
  )
}
<style>
  .sources {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
  }
  .sources h2 {
    font-size: 1.125rem;
  }
  ol {
    padding-left: 1.2rem;
  }
  li + li {
    margin-top: 0.4rem;
  }
</style>

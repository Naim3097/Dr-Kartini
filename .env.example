# Copy to .env and fill in before building for production.
# Google Search Console HTML-tag verification token (content value only)
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
PUBLIC_BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (tracks WhatsApp, phone, appointment and enquiry events)
PUBLIC_GA4_ID=
# Optional form backend (e.g. https://formspree.io/f/xxxxxx). If empty, the enquiry form opens WhatsApp.
PUBLIC_FORM_ENDPOINT=
# Set to true to include draft articles in a preview build
PUBLIC_SHOW_DRAFTS=false
